PORT=9000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=HealthSage
MONGO_DB_NAME=HealthSage_v1

# Auth
JWT_SECRET=change_me_in_real_env
JWT_EXPIRES_IN=1h

# FastAPI (internal AI service)
FASTAPI_BASE_URL=http://localhost:8000/api/v1

# CORS
CORS_ORIGIN=http://localhost:19006
