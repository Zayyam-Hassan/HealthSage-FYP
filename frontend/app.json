{
  "expo": {
    "name": "HealthSage",
    "slug": "healthsage",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/logo_final.png",
    "scheme": "healthsage",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo_final.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.zayyam.healthsage"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo_final.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo_final.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/logo_final.png",
          "color": "#E66A6A",
          "sounds": [],
          "mode": "production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2cf8e458-b1fb-4a38-a265-7155d37870f4"
      },
      "expressApiUrl": "https://health-sage-fyp.vercel.app/api/v1",
      "fastApiUrl": "http://13.63.229.105/api/v1"
    },
    "owner": "zayyam"
  }
}
